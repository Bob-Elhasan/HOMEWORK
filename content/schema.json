{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson",
  "description": "A tutor lesson. Answer keys are private and must never be sent to the child as text.",
  "type": "object",
  "required": [
    "id",
    "curriculum",
    "subject",
    "grade",
    "status",
    "learning_objectives",
    "skills",
    "explain",
    "questions",
    "explain_back"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]{2}\\.g[2-8]\\.[a-z0-9.-]+$" },
    "curriculum": {
      "type": "string",
      "enum": ["moe-eg", "alsson-uk-national", "alsson-us-ccss-ngss"]
    },
    "subject": {
      "type": "string",
      "enum": ["arabic", "social-studies", "math", "science"]
    },
    "grade": { "type": "integer", "minimum": 2, "maximum": 8 },
    "status": { "type": "string", "enum": ["draft", "in-review", "published"] },
    "teacher_review": {
      "type": "object",
      "properties": {
        "reviewer": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["reviewer", "date"]
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "source_outcomes"],
        "properties": {
          "text": { "type": "string" },
          "source_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "explain": { "type": "string", "minLength": 1 },
    "scenes": { "type": "array", "items": { "type": "string" } },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "license"],
        "properties": {
          "id": { "type": "string" },
          "license": { "type": "string" },
          "caption": { "type": "string" },
          "prompt": { "type": "string" }
        }
      }
    },
    "demos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "predict_first"],
        "properties": {
          "id": { "type": "string" },
          "predict_first": { "type": "string" }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "think_prompt", "rubric", "answer_key", "hints"],
        "properties": {
          "id": { "type": "string" },
          "think_prompt": { "type": "string" },
          "rubric": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "answer_key": { "type": "string" },
          "hints": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string" }
          }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wrong_idea", "exposing_question"],
        "properties": {
          "wrong_idea": { "type": "string" },
          "exposing_question": { "type": "string" }
        }
      }
    },
    "explain_back": { "type": "string", "minLength": 1 }
  }
}
