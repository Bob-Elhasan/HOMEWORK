{
  "name": "study-companion",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "jest",
    "build:catalog": "node scripts/build-catalog.mjs",
    "test:catalog": "node scripts/build-catalog.mjs --check && node scripts/test-catalog.mjs",
    "refresh:check": "python3 scripts/refresh_catalog.py check",
    "test:refresh": "python3 -m unittest scripts/test_refresh_catalog.py",
    "test:tutor": "node --test supabase/functions/_shared/tutor/test/*.test.ts",
    "eval:tutor": "node scripts/eval-tutor.mts",
    "tutor:chat": "node scripts/tutor-chat.mts"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-font": "~13.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "i18next": "^23.16.0",
    "react": "18.3.1",
    "react-i18next": "^15.0.0",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
